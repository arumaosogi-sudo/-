# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local PGlite database
/.data

.vercel
.env*

# Neon claimable-project identity
.neon

# Android app signing (never commit)
/android/*.keystore
/android/signing.env

# Android build outputs
/android/*.apk
/android/*.aab
/android/app/build
/android/.gradle

# Android build leftovers and local tooling
/android/build
/android/*.idsig
/.claude
