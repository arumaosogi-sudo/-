# --- Database ---
# Leave empty to use the built-in local database (PGlite, stored in .data/).
# For production, paste your Neon connection string (pooled) here.
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=generate-with: npx @better-auth/cli secret
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to sign in (comma separated, wildcards ok), e.g. a test tunnel.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- LINE Login (teachers sign in with LINE) ---
# One LINE Login channel for the whole app. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# --- Teachers' LINE Official Accounts ---
# Each teacher enters their own OA keys in the app (Settings). They are stored
# encrypted with this key: 32 random bytes, base64. Never change it in production.
LINE_CREDENTIALS_KEY=
# 1 = never call LINE when sending/replying (local testing; messages go to the server log).
LINE_DRY_RUN=

# --- Scheduler ---
# Random secret; the scheduler must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
